# Installs the latest knit-spool GitHub release and rolls back when it does not come up healthy.
# Started by knit-spool-update.timer; run it by hand with `sudo systemctl start knit-spool-update`.
# Settings: /etc/knit-spool/update.env (see the header of knit-spool-update). Add notification
# credentials with a drop-in (systemctl edit knit-spool-update), not by editing this file.
[Unit]
Description=Update knit-spool from the latest GitHub release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/knit-spool/update.env
ExecStart=/usr/local/libexec/knit-spool-update
StateDirectory=knit-spool-update
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=15min
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /var/lib/knit-spool /var/backups/knit-spool
