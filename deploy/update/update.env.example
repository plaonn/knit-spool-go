# /etc/knit-spool/update.env for knit-spool-update. Only KNIT_UPDATE_ASSET is required.
# Pick the asset for this host: knit-spool-linux-{amd64,arm64,armv7,armv6}.
KNIT_UPDATE_ASSET=knit-spool-linux-armv7
# The env files knit-spool.service reads, so `knit-spool check` sees the same configuration.
KNIT_UPDATE_ENV_FILES=/etc/knit-spool/knit-spool.env
# Optional: a command run as `NOTIFY SEVERITY TITLE DETAIL` after an update or a rollback.
#KNIT_UPDATE_NOTIFY=/usr/local/libexec/knit-spool-update-notify
